{
  "name": "framed-stream-core",
  "version": "1.0.0",
  "description": "Binary framing (magic + unsigned varint length + payload + CRC32) with an incremental decoder.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/framer.test.ts test/decoder.test.ts"
  },
  "keywords": [
    "framing",
    "varint",
    "crc32",
    "stream",
    "binary"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
